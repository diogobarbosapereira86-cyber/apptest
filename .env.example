# Copie este arquivo para ".env" e coloque sua chave da API do Claude.
# Pegue a chave em https://platform.claude.com (menu "API Keys").
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Opcional: um código que quem usar o site precisa digitar antes de gerar conteúdo.
# Deixe vazio para não pedir código.
CODIGO_DE_ACESSO=

# Opcional: quantas gerações cada visitante pode fazer por dia (padrão: 30).
MAX_GERACOES_POR_DIA=30

# Opcional: chave da Pollinations (https://pollinations.ai) para o botão
# "Imagem gerada pela IA" em "Criar com IA". A conta grátis vem com um saldo
# pequeno de uso. Sem chave, o botão some e a arte usa as fotos do cliente
# ou as cores da marca, que não custam nada.
POLLINATIONS_API_KEY=

# Opcional: porta do servidor (padrão: 3000).
PORT=3000
