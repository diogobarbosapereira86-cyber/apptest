# Copie este arquivo para ".env" e coloque sua chave da API do Claude.
# Pegue a chave em https://platform.claude.com (menu "API Keys").
ANTHROPIC_API_KEY=coloque-sua-chave-aqui

# Opcional: um código que quem usar o site precisa digitar antes de gerar conteúdo.
# Deixe vazio para não pedir código.
CODIGO_DE_ACESSO=

# Opcional: quantas gerações cada visitante pode fazer por dia (padrão: 30).
MAX_GERACOES_POR_DIA=30

# Opcional: chave da API do Gemini (https://aistudio.google.com, "Get API key")
# para o botão "Imagem gerada pelo Gemini" em "Criar com IA". Gerar imagem
# exige faturamento ativo (cerca de US$ 0,03 por imagem). Sem chave, o botão
# some e a arte usa as fotos do cliente ou as cores da marca, que não custam nada.
GEMINI_API_KEY=

# Opcional: modelo de imagem do Gemini (padrão: gemini-3.1-flash-lite-image).
GEMINI_IMAGE_MODEL=

# Opcional: porta do servidor (padrão: 3000).
PORT=3000
